          "name": "Gateway info",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway}}/",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                ""
              ]
            }
          }
        },
        {
          "name": "Platform status (registry + breakers)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
